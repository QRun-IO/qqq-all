<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
   <modelVersion>4.0.0</modelVersion>

   <parent>
      <groupId>com.kingsrook.qqq</groupId>
      <artifactId>qqq-all-parent</artifactId>
      <version>${revision}</version>
   </parent>

   <artifactId>qqq-all-bom</artifactId>
   <packaging>pom</packaging>

   <name>QQQ All - Stack BOM</name>
   <description>One tested version set for QQQ, the ESB, the Next dashboard, the included qBits, JDBC drivers, and broker clients.</description>

   <properties>
      <qqq.version>4.1.0-SNAPSHOT</qqq.version>

      <!-- qBits: develop builds on qbit-build-parent 2.0.0; none has a release on that parent yet. -->
      <qbit-quick-search.version>0.2.1-SNAPSHOT</qbit-quick-search.version>
      <qbit-user-role-permissions.version>0.33.0-SNAPSHOT</qbit-user-role-permissions.version>
      <qbit-customizable-table-views.version>0.5.0-SNAPSHOT</qbit-customizable-table-views.version>
      <qbit-standard-process-trace.version>0.3.0-SNAPSHOT</qbit-standard-process-trace.version>
      <qbit-webhooks.version>0.4.0-SNAPSHOT</qbit-webhooks.version>
      <qbit-workflows.version>0.114.0-SNAPSHOT</qbit-workflows.version>
      <qbit-geo-data.version>0.2.0-SNAPSHOT</qbit-geo-data.version>
      <qbit-sftp-data-integration.version>0.4.0-SNAPSHOT</qbit-sftp-data-integration.version>

      <!-- The versions qqq 4.1 builds and tests its backend modules and qqq-esb with. -->
      <postgresql.version>42.7.12</postgresql.version>
      <mysql-connector-j.version>9.5.0</mysql-connector-j.version>
      <sqlite-jdbc.version>3.51.1.0</sqlite-jdbc.version>
      <h2.version>2.4.240</h2.version>
      <artemis.version>2.57.0</artemis.version>
      <rabbitmq-jms.version>3.9.0</rabbitmq-jms.version>
   </properties>

   <dependencyManagement>
      <dependencies>
         <!-- QQQ modules, qqq-esb, and qqq-frontend-next. -->
         <dependency>
            <groupId>com.kingsrook.qqq</groupId>
            <artifactId>qqq-bom-pom</artifactId>
            <version>${qqq.version}</version>
            <type>pom</type>
            <scope>import</scope>
         </dependency>

         <!-- qBits -->
         <dependency>
            <groupId>com.kingsrook.qbits</groupId>
            <artifactId>qbit-quick-search</artifactId>
            <version>${qbit-quick-search.version}</version>
         </dependency>
         <dependency>
            <groupId>com.kingsrook.qbits</groupId>
            <artifactId>qbit-user-role-permissions</artifactId>
            <version>${qbit-user-role-permissions.version}</version>
         </dependency>
         <dependency>
            <groupId>com.kingsrook.qbits</groupId>
            <artifactId>qbit-customizable-table-views</artifactId>
            <version>${qbit-customizable-table-views.version}</version>
         </dependency>
         <dependency>
            <groupId>com.kingsrook.qbits</groupId>
            <artifactId>qbit-standard-process-trace</artifactId>
            <version>${qbit-standard-process-trace.version}</version>
         </dependency>
         <dependency>
            <groupId>com.kingsrook.qbits</groupId>
            <artifactId>qbit-webhooks</artifactId>
            <version>${qbit-webhooks.version}</version>
         </dependency>
         <dependency>
            <groupId>com.kingsrook.qbits</groupId>
            <artifactId>qbit-workflows</artifactId>
            <version>${qbit-workflows.version}</version>
         </dependency>
         <dependency>
            <groupId>com.kingsrook.qbits</groupId>
            <artifactId>qbit-geo-data</artifactId>
            <version>${qbit-geo-data.version}</version>
         </dependency>
         <dependency>
            <groupId>com.kingsrook.qbits</groupId>
            <artifactId>qbit-sftp-data-integration</artifactId>
            <version>${qbit-sftp-data-integration.version}</version>
         </dependency>

         <!-- JDBC drivers -->
         <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
         </dependency>
         <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector-j.version}</version>
         </dependency>
         <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
         </dependency>
         <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
         </dependency>

         <!-- Broker clients for qqq-esb -->
         <dependency>
            <groupId>org.apache.artemis</groupId>
            <artifactId>artemis-jakarta-client</artifactId>
            <version>${artemis.version}</version>
         </dependency>
         <dependency>
            <groupId>com.rabbitmq.jms</groupId>
            <artifactId>rabbitmq-jms</artifactId>
            <version>${rabbitmq-jms.version}</version>
         </dependency>
      </dependencies>
   </dependencyManagement>

</project>
